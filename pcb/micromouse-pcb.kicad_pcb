	(gr_text "Find good places for these:\nIndicator LEDs\nTestPoints\nBuzzer\nGooo button\nNeopixel WS2812 LEDs\n\nRefer back to schematic!! (It's very helpful)\nAdjust assigned Teensy pins for these as necessary"
		(at 86 -11.5 0)
		(layer "Cmts.User")
		(uuid "faa029ab-cefd-45cf-8ca4-d65e2e71ca23")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "45 degree IRs: 3mm cartesian distance from each other\n3√2 = 4.24"
		(at 98 66 0)
		(layer "Cmts.User")
		(uuid "18a61b28-be97-41d1-b4ac-22d7cc78572c")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "Don't route any power pins/GND\nWe will have dedicated power & ground planes!\n(Crudely drawn)\n\nUse vias from SMD pads to connect power/ground to the planes."
